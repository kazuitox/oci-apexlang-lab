#!/usr/bin/env bash
set -euo pipefail
umask 077
if [[ $(id -un) != opc ]]; then
  echo 'Run adb-connect as opc (without sudo).' >&2
  exit 1
fi
db_user=${1:-ADMIN}
if [[ ! "$db_user" =~ ^[A-Za-z][A-Za-z0-9_]{0,127}$ ]]; then
  echo 'Use an unquoted database username containing letters, numbers and underscores.' >&2
  exit 2
fi
[[ -r /home/opc/.adb/wallet.zip ]] || { echo 'Wallet is not ready. Run apexlang-status.' >&2; exit 1; }
db_name=$(/usr/bin/python3.11 -c 'import json; print(json.load(open("/etc/apexlang/config.json"))["adb_name"])')
[[ "$db_name" =~ ^[a-z][a-z0-9]{0,13}$ ]]
connection_script=$(mktemp)
trap 'unlink "$connection_script"' EXIT
printf 'set cloudconfig /home/opc/.adb/wallet.zip\nconnect %s@%s_low\n' "$db_user" "$db_name" > "$connection_script"
sql -L /nolog "@$connection_script"
